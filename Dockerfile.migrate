FROM docker.m.daocloud.io/golang:1.25-alpine AS builder
WORKDIR /app
ENV GOPROXY=https://goproxy.cn,direct
# Copy sources before resolving dependencies so local module replacements, if
# present, are available during go mod download as well as compilation.
COPY . .
RUN go mod download
RUN CGO_ENABLED=0 go build -trimpath -o /bin/marketplace-migrate ./cmd/marketplace-migrate

FROM docker.m.daocloud.io/alpine:3.21
RUN apk add --no-cache ca-certificates tzdata && addgroup -g 10001 migration && adduser -D -u 10001 -G migration migration
COPY --from=builder /bin/marketplace-migrate /bin/marketplace-migrate
USER 10001:10001
ENTRYPOINT ["/bin/marketplace-migrate"]
